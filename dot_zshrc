# --- Validación de Entorno de Terminal ---

# Obtenemos el nombre del proceso padre (el emulador de terminal)
TERMINAL_EMULATOR=$(ps -p $PPID -o comm=)

if [ -z "$TMUX" ]; then
    echo "TMUX: $TMUX..."
    case "$TERMINAL_EMULATOR" in
        *alacritty*)

          echo "TERMINAL EMULATOR: $TERMINAL_EMULATOR..."
            # Si es Alacritty, entramos en el flujo de trabajo de Homelab
            eval "$(starship init zsh)"
            echo "🚀 Alacritty detectado: Iniciando :entorno de desarrollo..."
            tmux attach-session -t default 2>/dev/null || tmux new-session -s default
            ;;
        *ptysis*|*gnome-terminal*|*prompt*)
            # Si es PTYsis, mantenemos el shell limpio para mantenimiento
            echo "🛠️  Terminal de respaldo (PTYsis) detectada: Shell limpio listo."
            ;;
        *)
            # Cualquier otra terminal (o TTY virtual)
            ;;
    esac
fi




