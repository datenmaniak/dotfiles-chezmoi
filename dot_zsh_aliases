# ========================================
# ALIASES OPTIMIZADOS
# ========================================

# ----------------------------------------
# NAVEGACIÓN RÁPIDA
# ----------------------------------------
alias c='cd'
alias c..='cd ..'
alias c...='cd ../..'
alias c....='cd ../../..'
alias cdev='cd ~/dev'
alias cdot='cd ~/.dotfiles'
alias cconf='cd ~/.config'
alias cchez='cd ~/.local/share/chezmoi'
alias d='dirs -v'
alias dh='cd ~'
alias d1='cd +1'
alias d2='cd +2'
alias d0='cd -'
alias q='exit'
alias cl='clear'
alias cls='clear && ls'
alias path='echo $PATH | tr ":" "\n" | nl'

# ----------------------------------------
# LISTADO (con eza)
# ----------------------------------------
alias ls='eza -lh --group-directories-first --icons=auto'
alias lsa='ls -a'
alias ll='eza -l --icons=auto --group-directories-first'
alias l='eza -lh --icons=auto'
alias la='eza -la --icons=auto'
alias l1='eza -1'
alias l.='eza -d .*'
alias tree1='eza --tree --level=1'
alias tree2='eza --tree --level=2'
alias treeg='eza --tree --git-ignore'

# ----------------------------------------
# PODMAN (optimizado y sin duplicados)
# ----------------------------------------
alias p='podman'
alias pc='podman-compose'
alias pe='podman exec -it'
alias pl='podman logs -f'
alias pr='podman run -it --rm'
alias prd='podman run -d'
alias psa='podman ps -a'
alias psr='podman ps'
alias psu='podman system prune -f'
alias pi='podman images'
alias pils='podman image list'
alias pipu='podman pull'
alias piprune='podman image prune -f'
alias pirm='podman image rm -f'
alias podb='podman build '
alias psta='podman start -i'
alias psto='podman stop'
alias pres='podman restart'
alias prmf='podman rm -f'
alias plp='podman port'
alias pvol='podman volume ls'
alias pnl='podman network ls'
alias pni='podman network inspect'
alias psi='podman system info'

# ----------------------------------------
# PODMAN-COMPOSE
# ----------------------------------------
alias pcu='podman-compose up -d'
alias pcd='podman-compose down'
alias pcdv='podman-compose down -v'
alias pcl='podman-compose logs -f'
alias pcr='podman-compose restart'

# ----------------------------------------
# DISTROBOX
# ----------------------------------------
alias dbls='distrobox list'
alias dbcr='distrobox create --name'
alias dben='distrobox enter'
alias dbxp='distrobox-export --app'
alias dbrm='distrobox rm -f'

# ----------------------------------------
# CHEZMOI
# ----------------------------------------
alias czs='chezmoi status'
alias czd='chezmoi diff'
alias cza='chezmoi apply -v'
alias czr='chezmoi re-add'
alias czdiff='chezmoi diff --verbose'
alias czedit='chezmoi edit'
alias czadd='chezmoi add'
alias czapply='chezmoi apply -v --force'
alias czrepo='cd ~/.local/share/chezmoi/ && ls -la'

# ----------------------------------------
# GIT
# ----------------------------------------
alias g='git'
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gcm='git commit -m'
alias gp='git push'
alias gpl='git pull'
alias gl='git log --oneline --graph'
alias gd='git diff'
alias gb='git branch'
alias gco='git checkout'

# ----------------------------------------
# KUBERNETES
# ----------------------------------------
alias k='kubectl'
alias m='minikube'
alias k-get='kubectl get'
alias k-describe="kubectl describe"
alias k-apply="kubectl apply"
alias k-delete="kubectl delete"
alias k-log="kubectl log"

# ----------------------------------------
# HISTORIAL (lo que pediste)
# ----------------------------------------
alias h='history -n 1 | tail -50'
alias hg='history -n 1 | grep'
alias hfzf='history -n 1 | fzf --tac --tiebreak=index'
alias ht='history -n 1 | awk "{print \$2}" | sort | uniq -c | sort -rn | head -20'
alias hist='history -E 1 | tail -50 | nl'

# ----------------------------------------
# BÚSQUEDA Y VISUALIZACIÓN
# ----------------------------------------
alias grep='ug --color=auto'
alias grepi='ug -i'
alias grepr='ug -r'
alias egrep='ug -E'
alias fgrep='ug -F'
alias cat='bat --style=plain --pager=never'
alias less='bat --pager=less'
alias ff='fzf --preview "bat --style=numbers --color=always {} 2>/dev/null || cat {}"'
alias fp='ps aux | fzf --header-lines=1'

# ----------------------------------------
# SISTEMA
# ----------------------------------------
alias dfh='df -h | grep -v "tmpfs\|loop"'
alias du1='du -h --max-depth=1 | sort -hr'
alias ports='ss -tulpn | grep LISTEN'
alias ss='ss -tlpn'
alias please='sudo $(fc -ln -1)'

# ----------------------------------------
# SSH Y REMOTO
# ----------------------------------------
alias pve="ssh -i ~/.ssh/datenmaniak root@pve.dk.lab"
alias k3s="ssh -i ~/.ssh/datenmaniak datenk@fw.dk.lab -p 2210"
alias wk1="ssh -i ~/.ssh/datenmaniak datenk@fw.dk.lab -p 2211"
alias wk2="ssh -i ~/.ssh/datenmaniak datenk@fw.dk.lab -p 2212"
alias fw="ssh admin@fw.dk.lab"

# ----------------------------------------
# OTRAS HERRAMIENTAS
# ----------------------------------------
alias tf='terraform'
alias vi='nvim'
alias v='nvim'
alias open='xdg-open &>/dev/null'
alias neofetch='ublue-fastfetch'
alias neowofetch='ublue-fastfetch'
alias fastfetch='ublue-fastfetch'
alias php8000='php -S localhost:8000'

# ----------------------------------------
# FUNCIONES DE AYUDA
# ----------------------------------------
palias() {
    echo "🚀 ALIAS DISPONIBLES\n"
    echo "📂 NAVEGACIÓN: c, cdev, cdot, d (dirs), d1, d2"
    echo "🐳 PODMAN: p, ps, pr, pe, pl, pcu, pcd"
    echo "📦 DISTROBOX: dbls, dben, dbrm"
    echo "🔄 CHEZMOI: czs, czd, cza, czdiff, czedit"
    echo "📜 HISTORIAL: h (últimos 50), hfzf (buscar), ht (top comandos)"
    echo "🔍 BÚSQUEDA: grep, ff (archivos con fzf), fp (procesos)"
    echo "🎯 GIT: gs, ga, gc, gp, gl"
    echo ""
    echo "❓ USO: 'palias' para esta ayuda"
}
alias pa='palias'

# Limpieza (alias seguros)
alias pclean='pclean-all'
